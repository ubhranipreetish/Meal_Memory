# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# ── Supabase ─────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → Data API (URL + anon key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public production origin used in email confirmation links (no trailing slash).
# Local development falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From Supabase: Settings → Database → Connection string → "Transaction pooler"
# (URI, port 6543). Used by the deployed serverless app.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-ref:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# From Supabase: "Session pooler" (port 5432), or the direct connection if your
# machine supports IPv6. Used only by drizzle-kit for db:push/db:migrate.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-ref:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── AI (Google Gemini free tier) ─────────────────────────────────────────────
# From https://aistudio.google.com/apikey  (starts with AIza...)
GOOGLE_API_KEY=AIza...
# Optional override; defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# IANA timezone used for daily totals, meal slots, and reports.
APP_TIME_ZONE=Asia/Kolkata

# Optional for legacy cron routes. No jobs are scheduled by default.
# CRON_SECRET=replace-with-a-long-random-secret
